[
  {"name": "canonical", "replace": [], "error": null},
  {"name": "old-version-key", "replace": [["apiVersion:", "api_version:"]], "error": "api_version|apiVersion"},
  {"name": "old-tool-key", "replace": [["built_in:", "built-in:"]], "error": "built-in"},
  {"name": "both-version-keys", "replace": [["kind: Agent", "api_version: recurse.run/v1alpha1\nkind: Agent"]], "error": "api_version"},
  {"name": "both-tool-keys", "replace": [["built_in: true", "built_in: true\n  built-in: false"]], "error": "built-in"},
  {"name": "implicit-boolean", "replace": [["built_in: true", "built_in: yes"]], "error": null},
  {"name": "quoted-boolean", "replace": [["built_in: true", "built_in: 'yes'"]], "error": "built_in"},
  {"name": "implicit-name-boolean", "replace": [["name: example", "name: on"]], "error": "metadata.name"},
  {"name": "quoted-name", "replace": [["name: example", "name: 'on'"]], "error": null},
  {"name": "duplicate-key", "replace": [["built_in: true", "built_in: true\n  built_in: false"]], "error": "duplicate key"},
  {"name": "malformed-yaml", "replace": [["metadata:", "metadata: ["]], "error": "valid YAML"},
  {"name": "invalid-output-schema", "replace": [["best_f1: {type: number}", "best_f1: {type: invalid}"]], "error": "outputs"},
  {"name": "missing-task-property", "replace": [["    task:\n      type: string\n      default: Reach F1 {{ input.target_f1 }}.\n", ""]], "error": "inputs.properties.task must be declared"},
  {"name": "non-string-task", "replace": [["    task:\n      type: string\n      default: Reach F1 {{ input.target_f1 }}.", "    task:\n      type: integer\n      default: 1"]], "error": "inputs.properties.task.type must be string"},
  {"name": "empty-task-default", "replace": [["default: Reach F1 {{ input.target_f1 }}.", "default: ''"]], "error": "inputs.properties.task.default must be a non-empty string"},
  {"name": "optional-task-without-default", "replace": [["      default: Reach F1 {{ input.target_f1 }}.\n", ""]], "error": "inputs.properties.task must have a non-empty default or be listed in inputs.required"},
  {"name": "required-task-without-default", "replace": [["inputs:\n  type: object\n  properties:\n", "inputs:\n  type: object\n  required: [task]\n  properties:\n"], ["      default: Reach F1 {{ input.target_f1 }}.\n", ""]], "error": null},
  {"name": "reliability-limits", "replace": [["prompt: prompt.md", "prompt: prompt.md\n  max_llm_errors: 3\n  max_tool_errors: 0\n  timeout_tools: 30"]], "error": null},
  {"name": "negative-reliability-limit", "replace": [["prompt: prompt.md", "prompt: prompt.md\n  max_llm_errors: -1"]], "error": "agent\\.max_llm_errors must be at least 0"},
  {"name": "integral-float-limit", "replace": [["prompt: prompt.md", "prompt: prompt.md\n  max_tool_errors: 5.0"]], "error": "agent\\.max_tool_errors must be an integer"},
  {"name": "non-finite-timeout", "replace": [["prompt: prompt.md", "prompt: prompt.md\n  timeout_tools: .inf"]], "error": "agent\\.timeout_tools must be a finite number"},
  {"name": "null-timeout", "replace": [["prompt: prompt.md", "prompt: prompt.md\n  timeout_tools: null"]], "error": null}
]
