        "budget": {
          "max_trials": 3,
          "max_training_seconds": 120
        }
      },
      "specification": {
        "kind": "binary",
        "targets": [
          "y"
        ],
        "features": [
          "length",
          "left",
          "right",
          "bottom",
          "top",
          "diagonal"
        ],
        "seed": 42
