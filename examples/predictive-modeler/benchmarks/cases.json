    {
      "id": "penguins",
      "dataset_family": "penguins",
      "partition": "development",
      "source_sha256": "e07636bd8af74260099ea2f8678e2eabbf35def579940cc76f67061ee16c06c1",
      "request": {
        "dataset": "https://raw.githubusercontent.com/mwaskom/seaborn-data/71e2436a092d714350de0fc409ca8a8714e7e78f/penguins.csv",
        "task": "Predict species using only island, bill_length_mm, bill_depth_mm, flipper_length_mm, body_mass_g, sex. This is multiclass. Use a random split. Maximize macro F1. The entire fitted model must be at most 5000000 bytes. Require at most six raw input columns.",
        "quality": {
          "objective": {
            "metric": "f1",
            "direction": "maximize",
            "parameters": {
              "average": "macro"
            }
          },
          "constraints": [
            {
              "metric": "model_bytes",
              "operator": "<=",
              "value": 5000000
            },
            {
              "metric": "input_feature_count",
              "operator": "<=",
              "value": 6
            }
          ]
        },
        "budget": {
          "max_trials": 3,
          "max_training_seconds": 60
        }
      },
      "specification": {
        "kind": "multiclass",
        "targets": [
          "species"
        ],
        "features": [
          "island",
          "bill_length_mm",
          "bill_depth_mm",
          "flipper_length_mm",
          "body_mass_g",
          "sex"
        ],
        "split": "random"
      }
    },
