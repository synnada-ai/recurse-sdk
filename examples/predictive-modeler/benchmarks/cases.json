{
  "version": 1,
  "measurement_protocol": "predictive-modeler/v2",
  "cases": [
    {
      "id": "binary",
      "dataset_family": "example:bank-marketing",
      "partition": "development",
      "request": {
        "dataset": "example:bank-marketing",
        "task": "Predict whether a customer will subscribe to a term deposit (y=yes), before the call. Exclude duration. Maximize precision; require recall of at least 0.5. Use a reproducible stratified split to demonstrate classification, not future-campaign performance.",
        "quality": {
          "objective": {
            "metric": "precision",
            "direction": "maximize",
            "parameters": {
              "positive_label": "yes"
            }
          },
          "constraints": [
            {
              "metric": "recall",
              "parameters": {
                "positive_label": "yes"
              },
              "operator": ">=",
              "value": 0.5
            }
          ]
        },
        "budget": {
          "max_trials": 3,
          "max_training_seconds": 600
        }
      },
      "specification": {
        "kind": "binary",
        "targets": [
          "y"
        ],
        "features": [
          "age",
          "job",
          "marital",
          "education",
          "default",
          "housing",
          "loan",
          "contact",
          "month",
          "day_of_week",
          "campaign",
          "pdays",
          "previous",
          "poutcome",
          "emp.var.rate",
          "cons.price.idx",
          "cons.conf.idx",
          "euribor3m",
          "nr.employed"
        ]
      }
    },
